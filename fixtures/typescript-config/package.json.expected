{
  "name": "@acme/typescript-config",
  "version": "1.0.0",
  "description": "Package with TypeScript config file",
  "type": "module",
  "devDependencies": {
    "@ngrok/gen-x": "workspace:*"
  },
  "exports": {
    "./package.json": "./package.json",
    "./fooBarBaz": {
      "@acme/typescript-config/source": "./src/foo-bar-baz.ts",
      "import": "./dist/foo-bar-baz.js",
      "types": "./dist/foo-bar-baz.d.ts"
    },
    "./helloWorld": {
      "@acme/typescript-config/source": "./src/hello-world.ts",
      "import": "./dist/hello-world.js",
      "types": "./dist/hello-world.d.ts"
    }
  }
}
