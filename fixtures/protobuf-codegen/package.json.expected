{
  "name": "@acme/grpc-client",
  "version": "1.0.0",
  "description": "gRPC client with generated protobuf code",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./proto/auth": {
      "import": "./dist/proto/auth_pb.js",
      "types": "./dist/proto/auth_pb.d.ts"
    },
    "./proto/user": {
      "import": "./dist/proto/user_pb.js",
      "types": "./dist/proto/user_pb.d.ts"
    }
  }
}
